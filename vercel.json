{
  "installCommand": "npm install --prefix frontend --include=dev",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
